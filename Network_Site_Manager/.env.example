# Copy to .env and fill in. .env is gitignored.
#
# Same conventions as Lab_management (AIT QuickLab): Postgres through the
# Prisma pg adapter, the schema picked by ?schema=, local time for everything
# user-facing.

# PostgreSQL connection. Leave unset while developing the UI: every page reads
# the sample data in src/lib/sample-data.ts until the database is wired in.
#   postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=networkdb
DATABASE_URL=

# Public path the app is served under (central nginx forwards the prefix as is).
# Empty = served at the root. Inlined at BUILD time, so changing it is a rebuild.
#NEXT_PUBLIC_BASE_PATH=/network

# Users are UTC+7; containers are UTC otherwise.
TZ=Asia/Bangkok
